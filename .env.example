# --- Base de données (PostgreSQL, ex: Neon / Supabase) ---
DATABASE_URL="postgresql://user:password@host:5432/orchestrato"

# --- Clé maître de chiffrement des clés API utilisateur (AES-256-GCM) ---
# Générer avec : openssl rand -base64 32
# NE JAMAIS committer la vraie valeur. Stocker dans le secret manager de l'hébergeur.
ENCRYPTION_MASTER_KEY=""

# --- Clés LLM de démonstration (M0 uniquement, clés "en dur" pour tester la chaîne) ---
# En production, les clés proviennent de la table ApiKey (chiffrées), pas de l'env.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
