# --- Base de données (PostgreSQL, ex: Neon / Supabase) ---
DATABASE_URL="postgresql://user:password@host:5432/orchestrato"

# --- Clé maître de chiffrement (AES-256-GCM) ---
# Chiffre les secrets stockés en base (config OAuth GitHub de /setup).
# Générer avec : openssl rand -base64 32
# NE JAMAIS committer la vraie valeur. Stocker dans le secret manager de l'hébergeur.
ENCRYPTION_MASTER_KEY=""

# --- Moteur IA : Claude Code CLI ---
# L'app n'utilise QUE le binaire `claude` (Claude Code), installé et authentifié
# sur la machine du worker, avec son propre login (abonnement). Aucune clé API
# n'est requise ni transmise : l'environnement des process est filtré par une
# allowlist qui écarte toute variable *_API_KEY.

# --- Authentification (Auth.js v5 — GitHub OAuth) ---
# AUTH_SECRET : openssl rand -base64 33
AUTH_SECRET=""
# Les identifiants de l'OAuth App GitHub se saisissent depuis la page /setup
# (stockés chiffrés en base, provider activé sans redémarrage). Les variables
# ci-dessous restent un repli optionnel si tu préfères l'environnement.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Repli développement : accès ouvert + utilisateur local, sans login.
# Mettre "false" (ou retirer) en production pour imposer l'authentification.
ALLOW_DEV_USER="true"

# --- Observabilité (Sentry, optionnel) ---
# Sans DSN, la capture d'erreurs est désactivée (les logs structurés restent).
SENTRY_DSN=""

# --- Workspaces du mode Autonome ---
# Un run autonome lance l'agent Claude Code dans le workspace du projet (clone du
# dépôt). Racine des workspaces. Défaut : ./.workspaces
WORKSPACES_DIR=""
