# --- Base de données (PostgreSQL, ex: Neon / Supabase) ---
DATABASE_URL="postgresql://user:password@host:5432/orchestrato"

# --- Clé maître de chiffrement des clés API utilisateur (AES-256-GCM) ---
# Générer avec : openssl rand -base64 32
# NE JAMAIS committer la vraie valeur. Stocker dans le secret manager de l'hébergeur.
ENCRYPTION_MASTER_KEY=""

# --- Clés LLM de démonstration (M0 uniquement, clés "en dur" pour tester la chaîne) ---
# En production, les clés proviennent de la table ApiKey (chiffrées), pas de l'env.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# --- Modèle local (LM Studio / Ollama, OpenAI-compatible, gratuit) ---
# Ajoute une clé "ollama" (valeur quelconque, ex: "local") depuis la page
# d'accueil pour activer le provider local. Le routeur le préfère (coût nul).
LOCAL_AI_BASE_URL="http://localhost:1234/v1"
LOCAL_AI_MODEL="qwen-active"

# --- Authentification (Auth.js v5 — GitHub OAuth) ---
# AUTH_SECRET : openssl rand -base64 33
AUTH_SECRET=""
# Les identifiants de l'OAuth App GitHub se saisissent depuis la page /setup
# (stockés chiffrés en base, provider activé sans redémarrage). Les variables
# ci-dessous restent un repli optionnel si tu préfères l'environnement.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Repli développement : accès ouvert + utilisateur local, sans login.
# Mettre "false" (ou retirer) en production pour imposer l'authentification.
ALLOW_DEV_USER="true"
